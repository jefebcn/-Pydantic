# Variabili della dashboard (Vercel → Settings → Environment Variables, o .env.local in locale)

# Supabase → Project Settings → API. La chiave segreta va solo lato server.
# Valgono anche i nomi dell'integrazione Vercel: NEXT_PUBLIC_SUPABASE_URL e SUPABASE_SECRET_KEY.
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Password admin (pagina /accedi): serve per magazzino, impostazioni e per modificare le offerte.
# Panoramica e offerte restano pubbliche. Senza password chiunque può modificare.
DASHBOARD_PASSWORD=
