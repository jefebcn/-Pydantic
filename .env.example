# Variabili della dashboard (Vercel → Settings → Environment Variables, o .env.local in locale)

# Supabase → Project Settings → API. La chiave segreta va solo lato server.
# Valgono anche i nomi dell'integrazione Vercel: NEXT_PUBLIC_SUPABASE_URL e SUPABASE_SECRET_KEY.
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Password per aprire la dashboard (consigliata: senza, chiunque abbia il link vede le offerte)
DASHBOARD_PASSWORD=
