# Copia questo file in scraper/.env e compila i valori.

# Supabase → Project Settings → API
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Telegram: crea un bot con @BotFather (token), poi scrivigli un messaggio e
# apri https://api.telegram.org/bot<TOKEN>/getUpdates per leggere il chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Link alla dashboard (compare negli avvisi)
DASHBOARD_URL=

# Opzionali
# CYCLE_MINUTES=20
# PAGES_PER_SEARCH=2
# MIN_USED_PRICE=100
# DISCOUNT_PCT=22
# ALERT_MARGIN_PCT=40
# ALERT_PROFIT_EUR=50
