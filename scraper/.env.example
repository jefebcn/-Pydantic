# Copia questo file in scraper/.env e compila i valori.

# Supabase → Project Settings → API
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Telegram: crea un bot con @BotFather (token), poi scrivigli un messaggio e
# apri https://api.telegram.org/bot<TOKEN>/getUpdates per leggere il chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Link alla dashboard (compare negli avvisi)
DASHBOARD_URL=

# Opzionali
# CAP di consegna italiano usato per vedere prezzi e offerte (serve se l'IP non è italiano, es. San Marino)
# DELIVERY_ZIP=20121
# Velocità massima: lento (default) | normale | veloce. Se Amazon blocca, lo scanner rallenta da solo
# e risale dopo STEP_UP_AFTER_CYCLES cicli puliti, mai oltre questo valore.
# SCAN_SPEED=lento
# STEP_UP_AFTER_CYCLES=6
# Questi sovrascrivono il profilo scelto:
# CYCLE_MINUTES=60
# SEARCHES_PER_CYCLE=8
# PAGES_PER_SEARCH=1
# DELAY_MIN_S=10
# DELAY_MAX_S=25
# MAX_OFFER_FETCHES=15
# MIN_USED_PRICE=100
# DISCOUNT_PCT=22
# ALERT_MARGIN_PCT=40
# ALERT_PROFIT_EUR=50
